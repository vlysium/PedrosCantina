<!DOCTYPE html>
<html lang="da">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - PedrosCantina.Web</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<script defer src="~/js/site.js" asp-append-version="true"></script>
</head>

<body>
	<nav>
		<ul class="nav-list">
			<li><a class="button" asp-page="/Index">Forside</a></li>
			<li><a class="button" asp-page="/MonthlyPlan" asp-route-year="@(DateTime.Now.Year)" asp-route-month="@(DateTime.Now.Month)">Månedsplan</a></li>
			<li><a class="button" asp-page="/Employees">Medarbejdere</a></li>
			<li><a class="button" asp-page="/YearlyShiftDistribution" asp-route-year="@(DateTime.Now.Year)">Årlig vagtfordeling</a></li>
		</ul>
	</nav>

	<main>
		@RenderBody()
	</main>

	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
